#!/usr/bin/env python3
#
# based on MIT licensed nvchecker-notify
# https://github.com/lilydjwg/nvchecker/blob/scripts/nvchecker-notify
#

"""
A simple wrapper to send email notifications while running nvchecker.
"""

import os
import subprocess
import json
import traceback
from typing import TYPE_CHECKING

import platformdirs

# Logging
import logging

logging.basicConfig(
    level=logging.ERROR, format="%(asctime)s - %(levelname)s - %(message)s"
)
logger = logging.getLogger(__name__)


def get_default_config() -> str:
    """
    Retrieve the default configuration file path for nvchecker.

    This function constructs the default path for the nvchecker configuration
    file using the user configuration directory provided by platformdirs.

    Returns:
        str: The path to the default nvchecker configuration file.
    """
    confdir = platformdirs.user_config_dir(appname="nvchecker")
    file = os.path.join(confdir, "nvchecker.toml")
    logger.debug(f"Default config file path: {file}")
    return file


def get_default_emailconf() -> str:
    """
    Retrieve the default email configuration file path.

    This function constructs the default path for the email configuration
    file using the user configuration directory provided by platformdirs.

    Returns:
        str: The path to the default email configuration file.
    """
    confdir = platformdirs.user_config_dir(appname="nvchecker")
    file = os.path.join(confdir, "email.toml")
    logger.debug(f"Default email config file path: {file}")
    return file


def get_args():
    """
    Parse and return command-line arguments.

    Uses argparse to parse command-line options and arguments relevant to the
    nvchecker notification wrapper.

    Returns:
        argparse.Namespace: The parsed command-line arguments.
    """
    import argparse

    parser = argparse.ArgumentParser(
        description="send e-mail for available updates after running nvchecker"
    )
    default_config = get_default_config()
    parser.add_argument(
        "-c",
        "--file",
        metavar="FILE",
        type=str,
        default=default_config,
        help=f"software version configuration file [default: {default_config}]",
    )
    default_emailconf = get_default_emailconf()
    parser.add_argument(
        "-m",
        "--emailfile",
        metavar="FILE",
        type=str,
        default=default_emailconf,
        help=f"email configuration file [default: {default_emailconf}]",
    )
    parser.add_argument(
        "-k",
        "--keyfile",
        metavar="FILE",
        type=str,
        help="use specified keyfile (override the one in configuration file)",
    )
    parser.add_argument(
        "-t",
        "--tries",
        default=1,
        type=int,
        metavar="N",
        help="try N times when network errors occur",
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="mark all versions as updated after successfully sending the e-mail (nvtake --all)",
    )
    parser.add_argument(
        "--failures",
        action="store_true",
        help="exit with code 3 if failures / errors happen during checking",
    )
    parser.add_argument(
        "--testmail",
        action="store_true",
        help="send a test email, no more and no less",
    )
    parser.add_argument(
        "--debug", action="store_true", help="show the traceback in case of error"
    )

    args = parser.parse_args()
    logger.debug(f"Parsed arguments: {args}")
    return args


def send_mail(*message):
    """
    Send an email with the provided content.

    The email configuration is loaded from a TOML file specified via command-line
    arguments. The email message is constructed with an ASCII art header and a
    timestamp. Various SMTP and network errors are caught and logged appropriately.

    Args:
        *message: Variable length argument list representing parts of the email content.
    """
    if TYPE_CHECKING:
        import tomli as tomllib
    else:
        try:
            import tomllib
        except ModuleNotFoundError:
            import tomli as tomllib

    import datetime
    import smtplib
    import socket

    # Read email configuration from file
    args = get_args()
    mailConf = args.emailfile
    logger.debug(f"Loading email config from: {mailConf}")

    try:
        with open(mailConf, "rb") as f:
            config = tomllib.load(f)
            smtp_host = config.get("SMTP", {}).get("host", "test@example.com")
            smtp_port = config.get("SMTP", {}).get("port", 25)
            smtp_ssl = config.get("SMTP", {}).get("ssl", False)
            smtp_starttls = config.get("SMTP", {}).get("starttls", False)
            smtp_timeout = config.get("SMTP", {}).get("timeout", 15)
            auth_user = config.get("AUTH", {}).get("user", "user@example.com")
            auth_password = config.get("AUTH", {}).get("password", "PaSsWoRd")
            addr_from = config.get("ADDR", {}).get("from", "sender@example.com")
            addr_to = config.get("ADDR", {}).get("to", "receiver@example.com")
            logger.debug(
                f"Email config loaded: SMTP={smtp_host}:{smtp_port}, SSL={smtp_ssl}, StartTLS={smtp_starttls}, Auth={auth_user}"
            )
    except tomllib.TOMLDecodeError as e:
        logger.error(f"Error loading email configuration: {e}")
        logger.debug(traceback.format_exc())
        if args.failures:
            exit(3)
        else:
            exit(1)

    # Check configuration consistency
    if smtp_ssl and smtp_starttls is True:
        logger.warning("ssl and starttls are both set to true, ssl is preferred")

    # Construct email content with ASCII art header and timestamp
    now_dateTime = datetime.datetime.now().strftime("%c")

    headart = []
    headart.append("                _               _")
    headart.append("               | |             | |")
    headart.append(" _ ____   _____| |__   ___  ___| | _____ _ __")
    headart.append("| '_ \\ \\ / / __| '_ \\ / _ \\/ __| |/ / _ \\ '__|")
    headart.append("| | | \\ V / (__| | | |  __/ (__|   <  __/ |")
    headart.append("|_| |_|\\_/ \\___|_| |_|\\___|\\___|_|\\_\\___|_|")
    headart.append("\n")

    content = "\n".join(headart) + now_dateTime + "\n" + "".join(str(i) for i in message)

    mail = None

    try:
        # Set up SMTP connection to SMTP server
        logger.debug(f"Attempting to connect to SMTP server: {smtp_host}:{smtp_port}")
        if smtp_ssl is True:
            mail = smtplib.SMTP_SSL(smtp_host, smtp_port, timeout=smtp_timeout)
        else:
            mail = smtplib.SMTP(smtp_host, smtp_port, timeout=smtp_timeout)

        # Identify yourself to the SMTP server
        mail.ehlo()
        logger.debug("SMTP EHLO successful.")

        # Start TLS encryption if configured and not already using SSL
        if smtp_starttls is True and smtp_ssl is not True:
            mail.starttls()
            logger.debug("SMTP StartTLS successful.")

        # Authenticate with the SMTP server
        mail.login(auth_user, auth_password)
        logger.debug("SMTP login successful.")

        # Email details
        subject = f"nvchecker [{now_dateTime}]"

        # Construct email message with headers
        header = f"To: {addr_to}\nFrom: {addr_from}\nSubject: {subject}\n\n"
        content = header + content

        # Send the email
        logger.debug(f"Sending email to: {addr_to}")
        mail.sendmail(addr_from, addr_to, content)
        logger.debug("Email sent successfully.")

    except (
        smtplib.SMTPConnectError,
        socket.gaierror,
        OSError,
    ) as e:  # Catch connection errors
        logger.error(f"Connection error: {e}")
        logger.debug(traceback.format_exc())

    except smtplib.SMTPAuthenticationError as e:
        logger.error(f"SMTP Authentication Error: {e}")
        logger.debug(traceback.format_exc())
    except smtplib.SMTPServerDisconnected as e:
        logger.error(f"SMTP Server Disconnected: {e}")
        logger.debug(traceback.format_exc())
    except smtplib.SMTPException as e:  # Catch other SMTP errors
        logger.error(f"SMTP Error: {e}")
        logger.debug(traceback.format_exc())
    except Exception as e:  # Catch all other exceptions
        logger.error(f"Email Error: {e}")
        logger.debug(traceback.format_exc())
        if args.failures:
            exit(3)
        else:
            exit(1)

    finally:
        if mail:  # Close connection only if it was established
            mail.quit()
            logger.debug("SMTP connection closed.")


def main():
    """
    Execute the main program logic.

    This function parses command-line arguments, runs the nvchecker tool to check for
    updates, processes its output, and sends email notifications if updates are found
    or if a test email is requested. Additionally, it optionally marks all versions as
    updated using the nvtake command.
    """
    logger.debug("Starting main function execution.")
    args = get_args()
    logger.debug("Command-line arguments have been parsed.")

    # Activate debug mode if requested by command-line or environment variable
    debug_env = os.environ.get("DEBUG")
    if args.debug or (debug_env and debug_env.lower() in ("true", "1", "yes")):
        logger.setLevel(logging.DEBUG)
        logger.debug(
            "Debug mode activated based on command-line argument or environment variable."
        )
    else:
        logger.debug("Debug mode not activated.")

    updates = []

    if not args.testmail:
        logger.debug("Executing nvchecker to check for updates.")
        try:
            rfd, wfd = os.pipe()
            logger.debug("Pipe created for interprocess communication.")
            cmd = [
                "nvchecker",
                "--logger",
                "both",
                "--json-log-fd",
                str(wfd),
            ]
            if args.file:
                cmd.extend(["-c", args.file])
                logger.debug(f"Added configuration file argument: {args.file}")
            if args.keyfile:
                cmd.extend(["-k", args.keyfile])
                logger.debug(f"Added keyfile argument: {args.keyfile}")
            if args.tries:
                cmd.extend(["-t", str(args.tries)])
                logger.debug(f"Added tries argument: {args.tries}")
            if args.failures:
                cmd.append("--failures")
                logger.debug("Added failures flag.")

            logger.debug(f"Running nvchecker with command: {' '.join(cmd)}")
            process = subprocess.Popen(cmd, pass_fds=(wfd,))
            logger.debug("nvchecker process started.")
            os.close(wfd)
            logger.debug("Write-end of the pipe closed.")

            output = os.fdopen(rfd)
            logger.debug("Read-end of the pipe opened to capture process output.")
            for o in output:
                try:
                    j = json.loads(o)
                    logger.debug(f"Received JSON output: {j}")
                    event = j.get("event")
                    if event == "updated":
                        update_message = (
                            "%(name)s: updated from %(old_version)s to %(version)s" % j
                        )
                        updates.append(update_message)
                        logger.debug(f"Update detected: {update_message}")
                except json.JSONDecodeError as e:
                    logger.error(f"Error decoding JSON from output line: {o} - {e}")
            output.close()

            ret = process.wait()
            logger.debug(f"nvchecker process completed with exit code: {ret}")
            if ret != 0:
                raise subprocess.CalledProcessError(ret, cmd)
        except subprocess.CalledProcessError as e:
            logger.error(f"Error running nvchecker: {e}")
            logger.error(f"Command: {e.cmd}")
            logger.error(f"Return code: {e.returncode}")
            logger.debug(traceback.format_exc())
            if args.failures:
                exit(3)
            else:
                exit(1)
            return
        except json.JSONDecodeError as e:
            logger.error(f"Error decoding JSON: {e}")
            logger.debug(traceback.format_exc())
            if args.failures:
                exit(3)
            else:
                exit(1)
            return

        if updates:
            logger.debug(
                "Updates found. Sending email notification with update details."
            )
            send_mail("\n".join(updates))
        else:
            logger.debug("No updates detected; no email will be sent.")

        if args.update:
            logger.debug("Update flag set. Running nvtake to mark updates as applied.")
            try:
                rfd, wfd = os.pipe()
                logger.debug("Pipe created for nvtake process communication.")
                cmd_take = [
                    "nvtake",
                    "--logger",
                    "both",
                    "--json-log-fd",
                    str(wfd),
                    "--all",
                ]
                if args.file:
                    cmd_take.extend(["--file", args.file])
                    logger.debug(
                        f"Added configuration file argument to nvtake: {args.file}"
                    )
                logger.debug(f"Running nvtake with command: {' '.join(cmd_take)}")
                process_take = subprocess.Popen(cmd_take, pass_fds=(wfd,))
                logger.debug("nvtake process started.")
                os.close(wfd)
                logger.debug("Write-end of the nvtake pipe closed.")
                ret_take = process_take.wait()
                logger.debug(f"nvtake process completed with exit code: {ret_take}")
                if ret_take != 0:
                    raise subprocess.CalledProcessError(ret_take, cmd_take)
            except subprocess.CalledProcessError as e:
                logger.error(f"Error running nvtake: {e}")
                logger.error(f"Command: {e.cmd}")
                logger.error(f"Return code: {e.returncode}")
                logger.debug(traceback.format_exc())
                if args.failures:
                    exit(3)
                else:
                    exit(1)
                return
    else:
        logger.debug("Test mail mode enabled; sending test email.")
        send_mail("\nTest fast, fail fast, adjust fast.\nTom Peters")

    logger.debug("Main function execution completed.")


if __name__ == "__main__":
    main()
